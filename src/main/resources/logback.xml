<configuration>

    <!-- Same directory as AppPaths.logDir: $XDG_STATE_HOME/LibreMTD/log,
         otherwise ~/.local/state/LibreMTD/log -->
    <property name="APP_LOG_DIR" value="${XDG_STATE_HOME:-${user.home}/.local/state}/LibreMTD/log" />

    <!--
        One log file per logged-in user, so that two LibreMTD windows for two
        different users never write to the same file.  Before login and after
        logout the file is app.log.

        The file name comes from CurrentUserLogDiscriminator (a process-wide
        value, not MDC, because MDC is per thread and LibreMTD logs from the
        JavaFX, IO and default coroutine threads).
    -->
    <appender name="FILE" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator class="org.charlesatkinson.libremtd.utils.CurrentUserLogDiscriminator">
            <key>logName</key>
            <defaultValue>app</defaultValue>
        </discriminator>
        <sift>
            <appender name="FILE-${logName}" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>${APP_LOG_DIR}/${logName}.log</file>

                <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                    <!-- One log file per day -->
                    <fileNamePattern>${APP_LOG_DIR}/${logName}-%d{yyyy-MM-dd}.log</fileNamePattern>
                    <maxHistory>365</maxHistory>
                </rollingPolicy>

                <encoder>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
                </encoder>
            </appender>
        </sift>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>

    <logger name="org.charlesatkinson.libremtd.network.HmrcApiClient" level="DEBUG"/>

</configuration>